<extension>
  <modules>
    <module>
      <id>AlfDockia Community Share Aikau Package</id>
      <version>1.0.0</version>
      <auto-deploy>true</auto-deploy>
      <configurations>
        <config evaluator="string-compare" condition="WebFramework" replace="false">
          <web-framework>
            <dojo-pages>
              <packages>
                <package name="alfdockia" location="resources/alfdockia"/>
              </packages>
            </dojo-pages>
          </web-framework>
        </config>
      </configurations>
    </module>
  </modules>
</extension>
